# =============================================================================
# HireRise .dockerignore — applies to both frontend and backend builds
# =============================================================================

# --- Secrets & local config (NEVER ship these) ---
.env
.env.*
!.env.example
!.env.production.example
*.key
*.pem
*.p12
*.pfx
claudeapi\ key.txt
"googlesheets api.txt"
"supa api.txt"
"supa data password.txt"

# --- Development artifacts ---
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm
.yarn

# --- Next.js build cache (rebuilt in Docker) ---
.next
out

# --- Test files ---
**/__tests__
**/tests
**/*.test.js
**/*.test.ts
**/*.spec.js
**/*.spec.ts
jest.config.*
coverage
.nyc_output

# --- Docs & data ---
docs
Career\ data
*.docx
*.xlsx
*.pdf
*.csv
*.json5
README.md
FOLDER_STRUCTURE.md
structure.txt

# --- Dev tooling ---
nodemon.json
.eslint*
.dependency-cruiser.cjs
dependency-cruiser*.cjs
.gitleaks.toml
*.sh
!scripts/docker-entrypoint.sh

# --- Git ---
.git
.gitignore
.githooks
.github

# --- Quarantine (never deploy) ---
**/quarantine
**/src/quarantine

# --- Misc ---
*.log
.DS_Store
Thumbs.db
*.zip
*.z0*
