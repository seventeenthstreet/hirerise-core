{
  "name": "hirerise-core",
  "version": "1.0.0",
  "description": "HireRise Career Intelligence Platform - Backend Core Engine",
  "main": "src/server.js",
  "engines": {
    "node": ">=20 <21",
    "npm": ">=10"
  },
  "packageManager": "npm@10.9.2",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon --signal SIGTERM src/server.js",
    "lint": "eslint src",
    "depcruise": "depcruise src --config .dependency-cruiser.cjs",
    "madge": "madge --circular src",
    "test": "cross-env NODE_ENV=test jest --runInBand",
    "test:watch": "cross-env NODE_ENV=test jest --watch",
    "test:contract": "cross-env NODE_ENV=test jest tests/contract/ --runInBand",
    "import:data": "node src/data-import/excelImporter.js",
    "health:smoke": "node scripts/health-smoke.js",
    "ready:smoke": "node scripts/ready-smoke.js",
    "security:scan": "gitleaks detect --verbose",
    "drift:check": "node scripts/check-migration-drift.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "@extractus/article-extractor": "^8.0.20",
    "otplib": "^12.0.1",
    "qrcode": "^1.5.4",
    "@google/generative-ai": "^0.24.1",
    "@supabase/supabase-js": "^2.99.2",
    "axios": "^1.15.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "csv-parser": "^3.2.0",
    "dotenv": "^16.6.1",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "ioredis": "^5.9.3",
    "mammoth": "^1.11.0",
    "morgan": "^1.10.0",
    "multer": "^2.1.1",
    "mupdf": "^1.27.0",
    "natural": "^8.1.1",
    "node-cache": "^5.1.2",
    "openai": "^6.33.0",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^1.1.4",
    "pdf2json": "^4.0.3",
    "pdfjs-dist": "^5.6.205",
    "redis": "^4.7.0",
    "stopword": "^2.0.8",
    "stripe": "^20.4.0",
    "unpdf": "^1.6.0",
    "winston": "^3.11.0",
    "ws": "^8.18.0",
    "zod": "^3.25.76",
    "rate-limit-redis": "^4.2.0"
  },
  "devDependencies": {
    "@babel/generator": "^7.29.1",
    "@babel/parser": "^7.29.2",
    "@babel/traverse": "^7.29.0",
    "@babel/types": "^7.29.0",
    "@types/express": "^5.0.6",
    "@types/node": "^25.5.0",
    "cross-env": "^10.1.0",
    "dependency-cruiser": "^16.10.4",
    "eslint": "^8.54.0",
    "eslint-plugin-local": "file:src/eslint-plugin-local",
    "jest": "^29.7.0",
    "madge": "^8.0.0",
    "nodemon": "^3.0.2",
    "supertest": "^6.3.4",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.8.3"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.js",
      "**/?(*.)+(spec|test).js"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/src/tests/setup.js"
    ],
    "clearMocks": true
  },
  "optionalDependencies": {
    "puppeteer": "^24.37.5"
  },
  "overrides": {
    "follow-redirects": ">=1.15.12",
    "brace-expansion": ">=1.1.13",
    "protobufjs": ">=7.5.5",
    "path-to-regexp": ">=0.1.13",
    "lodash": ">=4.17.24",
    "flatted": ">=3.4.0",
    "basic-ftp": ">=5.2.3",
    "@xmldom/xmldom": ">=0.8.13",
    "picomatch": ">=2.3.2",
    "minimatch": ">=3.1.4",
    "typescript": "^5.8.3"
  }
}